// Prisma schema for the ESN resource-management app.
// SOURCE OF TRUTH: docs/data-model.md — keep this file in sync with it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  RH
  MANAGER
  DIRECTION
  CONSULTANT
}

enum CandidateStatus {
  APPLIED
  INTERVIEW
  VALIDATED
  REJECTED
  HIRED
}

enum ConsultantStatus {
  INTERCONTRAT
  ON_MISSION
  AVAILABLE
}

enum MissionStatus {
  DRAFT
  STAFFED
  IN_PROGRESS
  CLOSED
  ARCHIVED
}

enum AssignmentStatus {
  PROPOSED
  CONFIRMED
  ACTIVE
  ENDED
}

enum ContractStatus {
  DRAFT
  INTERNAL_VALIDATION
  PENDING_SIGNATURE
  SIGNED
  ARCHIVED
}

enum ValidationStep {
  RH
  MANAGER
  DIRECTION
}

enum ValidationState {
  PENDING
  APPROVED
  REJECTED
}

enum DocumentType {
  CV
  CONTRACT
  CONTRACT_AMENDMENT
  PROPOSAL
  MISSION_DOC
  COVER_LETTER
  OTHER
}

enum EntityType {
  CANDIDATE
  CONSULTANT
  CLIENT
  MISSION
  CONTRACT
  CONTRACT_TEMPLATE
  ASSIGNMENT
  JOB_POST
  APPLICATION
  SKILL
  USER
}

// --- Job Offers + public application portal --------------------------------

enum JobPostStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  LINKED
  REJECTED
  SPAM
}

enum QuestionType {
  SHORT_TEXT
  LONG_TEXT
  SINGLE_CHOICE
  MULTI_CHOICE
  BOOLEAN
  NUMBER
}

enum EmploymentType {
  CDI
  CDD
  STAGE
  FREELANCE
}

enum SeniorityLevel {
  JUNIOR
  CONFIRMED
  SENIOR
  LEAD
}

/// AV quarantine stub — CLEAN/INFECTED set by a future antivirus worker.
enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

/// App account, mirrors a Keycloak subject. Source of identity + role.
model User {
  id         String   @id @default(cuid())
  keycloakId String   @unique
  email      String   @unique
  firstName  String
  lastName   String
  role       Role
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // 1:1 — a CONSULTANT user maps to a Consultant profile
  consultant Consultant?

  // Reverse relations for authored / actor links
  authoredInteractions  CandidateInteraction[] @relation("InteractionAuthor")
  evaluationsGiven      CandidateEvaluation[]  @relation("EvaluationEvaluator")
  missionAmendments     MissionAmendment[]     @relation("MissionAmendmentAuthor")
  contractAmendments    ContractAmendment[]    @relation("ContractAmendmentAuthor")
  contractValidations   ContractValidation[]   @relation("ContractValidator")
  uploadedDocuments     Document[]             @relation("DocumentUploader")
  jobPostsAuthored      JobPost[]              @relation("JobPostAuthor")
  reviewedApplications  Application[]          @relation("ApplicationReviewer")
  managedContracts      Contract[]             @relation("ContractManager")
  aiEvaluationsCreated  AiEvaluation[]         @relation("AiEvaluationCreator")

  @@index([role])
}

// ---------------------------------------------------------------------------
// Referential
// ---------------------------------------------------------------------------

/// Referential competence shared across the domain.
model Skill {
  id        String   @id @default(cuid())
  name      String   @unique
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Implicit many-to-many relations
  candidates  Candidate[]
  consultants Consultant[]
  missions    Mission[]
  jobPosts    JobPost[]
}

// ---------------------------------------------------------------------------
// Recruitment / ATS
// ---------------------------------------------------------------------------

model Candidate {
  id             String          @id @default(cuid())
  firstName      String
  lastName       String
  email          String          @unique
  phone          String?
  status         CandidateStatus @default(APPLIED)
  source         String?
  targetPosition String?
  notes          String?
  jobPostId      String? // origin job post if created via the public portal (null = RH-created)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  skills       Skill[]
  interactions CandidateInteraction[]
  evaluations  CandidateEvaluation[]
  proposals    Proposal[]
  applications Application[]

  // Set when the candidate is HIRED and converted to a Consultant
  consultant Consultant?

  @@index([status])
}

/// historique des échanges
model CandidateInteraction {
  id          String   @id @default(cuid())
  candidateId String
  type        String // CALL / EMAIL / INTERVIEW / NOTE
  occurredAt  DateTime
  summary     String
  authorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  author    User      @relation("InteractionAuthor", fields: [authorId], references: [id])

  @@index([candidateId])
  @@index([authorId])
}

/// évaluation des candidats
model CandidateEvaluation {
  id             String   @id @default(cuid())
  candidateId    String
  evaluatorId    String
  criteria       Json // per-criterion scores
  overallScore   Int
  recommendation String?
  comment        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  evaluator User      @relation("EvaluationEvaluator", fields: [evaluatorId], references: [id])

  @@index([candidateId])
  @@index([evaluatorId])
}

/// génération de proposition
model Proposal {
  id          String   @id @default(cuid())
  candidateId String
  status      String // DRAFT / SENT / ACCEPTED / DECLINED
  content     Json // offer terms
  documentId  String? // generated PDF in storage
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Consultants
// ---------------------------------------------------------------------------

/// fiche consultant centralisée
model Consultant {
  id               String           @id @default(cuid())
  userId           String           @unique
  position         String
  tjm              Decimal?         @db.Decimal(10, 2)
  status           ConsultantStatus @default(AVAILABLE)
  hireDate         DateTime?
  availabilityDate DateTime?
  seniority        String?
  bio              String?
  candidateId      String?          @unique
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user            User         @relation(fields: [userId], references: [id])
  candidateOrigin Candidate?   @relation(fields: [candidateId], references: [id])
  skills          Skill[]
  assignments     Assignment[]
  contracts       Contract[]

  @@index([status])
}

// ---------------------------------------------------------------------------
// Clients & Missions
// ---------------------------------------------------------------------------

model Client {
  id           String   @id @default(cuid())
  name         String
  industry     String?
  contactName  String?
  contactEmail String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  missions Mission[]

  @@index([name])
}

/// Gestion des missions
model Mission {
  id          String        @id @default(cuid())
  clientId    String
  project     String
  role        String
  description String?
  startDate   DateTime
  endDate     DateTime?
  tjm         Decimal       @db.Decimal(10, 2)
  status      MissionStatus @default(DRAFT)
  archivedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  client         Client             @relation(fields: [clientId], references: [id])
  requiredSkills Skill[]
  assignments    Assignment[]
  amendments     MissionAmendment[]

  @@index([clientId])
  @@index([status])
}

/// Staffing / Affectation — consultant <-> mission
model Assignment {
  id            String           @id @default(cuid())
  missionId     String
  consultantId  String
  roleOnMission String?
  startDate     DateTime
  endDate       DateTime?
  allocationPct Int              @default(100)
  status        AssignmentStatus @default(PROPOSED)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  mission    Mission    @relation(fields: [missionId], references: [id], onDelete: Cascade)
  consultant Consultant @relation(fields: [consultantId], references: [id])

  @@index([consultantId, status])
  @@index([missionId])
}

/// avenant de mission
model MissionAmendment {
  id            String   @id @default(cuid())
  missionId     String
  reason        String
  changes       Json // before/after deltas
  effectiveDate DateTime
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  createdBy User    @relation("MissionAmendmentAuthor", fields: [createdById], references: [id])

  @@index([missionId])
  @@index([createdById])
}

// ---------------------------------------------------------------------------
// Contracts
// ---------------------------------------------------------------------------

model ContractTemplate {
  id        String   @id @default(cuid())
  name      String
  body      String // template with {{placeholders}}
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contracts Contract[]

  @@index([isActive])
}

/// Gestion des contrats de travail
model Contract {
  id             String         @id @default(cuid())
  consultantId   String
  templateId     String?
  type           String // CDI / CDD / etc.
  status         ContractStatus @default(DRAFT)
  prefilledData  Json // auto-filled from Consultant
  managerId      String? // designated approver of the MANAGER step (null = legacy, any manager)
  generatedPdfId String? // generated PDF
  signedPdfId    String? // optional uploaded wet-signed scan (document attachment)
  startDate      DateTime?
  endDate        DateTime?
  archivedAt     DateTime?
  // Two-party in-app signing (not a qualified e-signature). SIGNED once both set.
  consultantSignedAt      DateTime? // consultant acknowledged/signed
  consultantSignatoryName String? // consultant name stamped at sign time
  companySignedAt         DateTime? // RH/DIRECTION countersigned
  companySignatoryName    String? // company signatory name stamped at countersign
  rejectionReason         String? // set on consultant reject (→ DRAFT); cleared on re-submit
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  consultant  Consultant           @relation(fields: [consultantId], references: [id])
  template    ContractTemplate?    @relation(fields: [templateId], references: [id])
  manager     User?                @relation("ContractManager", fields: [managerId], references: [id])
  validations ContractValidation[]
  amendments  ContractAmendment[]

  @@index([consultantId])
  @@index([templateId])
  @@index([status])
  @@index([managerId])
}

/// workflow RH -> Manager -> Direction
model ContractValidation {
  id          String          @id @default(cuid())
  contractId  String
  step        ValidationStep
  state       ValidationState @default(PENDING)
  validatorId String?
  decidedAt   DateTime?
  comment     String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  contract  Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  validator User?    @relation("ContractValidator", fields: [validatorId], references: [id])

  @@unique([contractId, step])
  @@index([contractId])
  @@index([validatorId])
  @@index([state])
}

/// avenant contractuel
model ContractAmendment {
  id             String   @id @default(cuid())
  contractId     String
  reason         String
  changes        Json
  effectiveDate  DateTime
  generatedPdfId String?
  signedPdfId    String?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contract  Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  createdBy User     @relation("ContractAmendmentAuthor", fields: [createdById], references: [id])

  @@index([contractId])
  @@index([createdById])
}

// ---------------------------------------------------------------------------
// Cross-cutting: Documents, Audit
// ---------------------------------------------------------------------------

/// Stockage centralisé — metadata only (bytes live in MinIO/S3)
model Document {
  id           String       @id @default(cuid())
  type         DocumentType
  entityType   EntityType
  entityId     String // polymorphic link
  filename     String
  mimeType     String
  sizeBytes    Int
  storageKey   String       @unique
  uploadedById String? // null for public (anonymous) application uploads
  scanStatus   ScanStatus   @default(PENDING) // AV quarantine stub
  archivedAt   DateTime? // soft-delete marker; MinIO object is retained
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  uploadedBy User? @relation("DocumentUploader", fields: [uploadedById], references: [id])

  @@index([entityType, entityId])
  @@index([uploadedById])
  @@index([type])
}

/// historisation / historique / alertes
model AuditLog {
  id         String     @id @default(cuid())
  entityType EntityType
  entityId   String
  action     String // CREATE / UPDATE / STATUS_CHANGE / ...
  actorId    String?
  payload    Json // diff / details
  createdAt  DateTime   @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
}

// ---------------------------------------------------------------------------
// Job Offers + public application portal
// ---------------------------------------------------------------------------

/// Offre d'emploi — public via an unguessable token when PUBLISHED.
model JobPost {
  id                 String         @id @default(cuid())
  title              String
  description        String
  requirements       String?
  location           String?
  employmentType     EmploymentType
  seniorityLevel     SeniorityLevel?
  minYearsExperience Int?
  status             JobPostStatus  @default(DRAFT)
  publicToken        String         @unique // 128-bit CSPRNG (not the cuid PK)
  publishedAt        DateTime?
  expiresAt          DateTime?
  archivedAt         DateTime?
  authorId           String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  author         User          @relation("JobPostAuthor", fields: [authorId], references: [id])
  requiredSkills Skill[] // implicit m2m (_JobPostToSkill)
  questions      JobQuestion[]
  applications   Application[]

  @@index([status])
  @@index([authorId])
}

/// Per-post custom question. Editable/reorderable/soft-deletable even after
/// applications exist — answers are frozen snapshots on Application.
model JobQuestion {
  id         String       @id @default(cuid())
  jobPostId  String
  key        String // stable machine key, unique per post
  label      String
  type       QuestionType
  required   Boolean      @default(false)
  options    Json? // choice types: string[]
  config     Json? // { min?, max?, maxLength? }
  order      Int
  helpText   String?
  archivedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  jobPost JobPost @relation(fields: [jobPostId], references: [id], onDelete: Cascade)

  @@unique([jobPostId, key])
  @@index([jobPostId])
}

/// Candidature reçue via le portail public. Decoupled from Candidate: RH "links"
/// it into the ATS later (creates/attaches a Candidate). `answers` is immutable.
model Application {
  id                String            @id @default(cuid())
  jobPostId         String
  firstName         String
  lastName          String
  email             String
  phone             String?
  consentAcceptedAt DateTime
  jobTitleSnapshot  String
  answers           Json // immutable: [{ key, label, type, value }]
  declaredSkills    Json? // snapshot: [{ name }]
  status            ApplicationStatus @default(SUBMITTED)
  candidateId       String?
  reviewedById      String?
  reviewedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  jobPost    JobPost    @relation(fields: [jobPostId], references: [id])
  candidate  Candidate? @relation(fields: [candidateId], references: [id])
  reviewedBy User?      @relation("ApplicationReviewer", fields: [reviewedById], references: [id])

  aiEvaluations AiEvaluation[]

  @@index([jobPostId, status])
  @@index([email])
  @@index([candidateId])
}

// ---------------------------------------------------------------------------
// AI evaluation (Claude) — application-vs-job-post matching
// ---------------------------------------------------------------------------

enum AiVerdict {
  STRONG_MATCH
  GOOD_MATCH
  PARTIAL_MATCH
  WEAK_MATCH
}

/// One row per AI evaluation run of an Application against its JobPost.
/// History is kept (re-evaluations append). Result fields come from a
/// structured-output LLM call, range-validated server-side before persist.
model AiEvaluation {
  id            String    @id @default(cuid())
  applicationId String
  score         Int // 0-100 (Zod-validated post-parse)
  verdict       AiVerdict
  strengths     Json // string[]
  gaps          Json // string[]
  reasoning     String    @db.Text
  cvUsed        Boolean   @default(false) // PDF CV fetched & sent to the model
  model         String // e.g. "claude-haiku-4-5"
  promptVersion String // e.g. "v1" — reproducibility across prompt iterations
  tokensInput   Int? // cost tracking
  tokensOutput  Int?
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdBy   User        @relation("AiEvaluationCreator", fields: [createdById], references: [id])

  @@index([applicationId])
  @@index([createdById])
}
