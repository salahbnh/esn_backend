# --- Server ---
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# --- Database (Postgres) ---
DATABASE_URL=postgresql://esn:esn@localhost:5432/esn

# --- Keycloak (OIDC / JWT) ---
KEYCLOAK_ISSUER=http://localhost:8080/realms/esn
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/esn/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=account

# --- Object storage (MinIO / S3) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=esn-documents
S3_REGION=us-east-1

# Keycloak Admin API (auto-provision consultant accounts on conversion)
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=esn
KEYCLOAK_ADMIN_CLIENT_ID=esn-backend
KEYCLOAK_ADMIN_CLIENT_SECRET=esn-backend-dev-secret
# Public frontend client id — scopes the set-password invite link's redirect.
KEYCLOAK_FRONTEND_CLIENT_ID=esn-frontend
# Set to true locally once Mailpit is running (see docker-compose.yml) to deliver
# the set-password invite email on candidate -> consultant conversion.
KEYCLOAK_INVITE_EMAIL=false

# Company email domain for generated consultant logins (prenom.nom@esn.local).
COMPANY_EMAIL_DOMAIN=esn.local

# AI evaluation (Claude) — OPTIONAL. The app runs fully without it; the
# "Évaluer avec IA" feature stays disabled until a key is provided here.
# ANTHROPIC_API_KEY=

# Public application portal (the app's only unauthenticated surface)
# Turnstile CAPTCHA secret — leave unset in dev (honeypot-only). Set to enable CAPTCHA.
# TURNSTILE_SECRET=
PUBLIC_UPLOAD_PREFIX=public-applications
PUBLIC_RATE_LIMIT_GET_MAX=30
PUBLIC_RATE_LIMIT_APPLY_IP_MAX=5
PUBLIC_RATE_LIMIT_APPLY_TOKEN_MAX=10
