# --- Server ---
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# --- Database (Postgres) ---
DATABASE_URL=postgresql://esn:esn@localhost:5432/esn

# --- Keycloak (OIDC / JWT) ---
KEYCLOAK_ISSUER=http://localhost:8080/realms/esn
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/esn/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=account

# --- Object storage (MinIO / S3) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=esn-documents
S3_REGION=us-east-1

# Keycloak Admin API (auto-provision consultant accounts on conversion)
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=esn
KEYCLOAK_ADMIN_CLIENT_ID=esn-backend
KEYCLOAK_ADMIN_CLIENT_SECRET=esn-backend-dev-secret
KEYCLOAK_INVITE_EMAIL=false
